{
  "name": "bizgrow-ai---lead-generation-engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "cd server && npm run dev",
    "server:start": "cd server && npm start",
    "server:install": "cd server && npm install",
    "server:init": "cd server && npm run init-db",
    "setup": "npm install && npm run server:install && npm run server:init",
    "dev:full": "concurrently \"npm run dev\" \"npm run server\"",
    "start:full": "concurrently \"npm run preview\" \"npm run server:start\"",
    "start": "node start.js",
    "deploy": "node deploy.js",
    "deploy:railway": "railway up",
    "deploy:docker": "docker-compose up -d --build"
  },
  "dependencies": {
    "@google/genai": "^1.34.0",
    "lucide-react": "^0.562.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
