{
  "version": 2,
  "name": "bizgrow-ai-frontend",
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "build": {
    "env": {
      "VITE_API_URL": "https://biggrow-production.up.railway.app/api",
      "VITE_WS_URL": "wss://biggrow-production.up.railway.app"
    }
  }
}